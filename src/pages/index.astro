---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AnfrageForm from '../components/AnfrageForm.astro';
import { site } from '../config';

const services = [
  { icon: 'doc', h: 'Belegvorerfassung', p: 'Belege sortieren, vorkontieren und in Ihrem System erfassen – nach Ihren Kontierungsregeln.' },
  { icon: 'inbox', h: 'Unterlagen einsammeln', p: 'Wir fragen fehlende Mandantenunterlagen an und bleiben dran, bis sie da sind.' },
  { icon: 'mail', h: 'E-Mail & Fristen', p: 'Postfach sortieren, Standardanfragen beantworten, Fristen und Rückläufer im Blick behalten.' },
  { icon: 'users', h: 'Neue Mandanten & Mieter', p: 'Aufnahmeunterlagen vorbereiten, Daten anlegen, Vollständigkeit prüfen.' },
  { icon: 'calendar', h: 'Termine koordinieren', p: 'Besichtigungen und Gespräche vereinbaren, bestätigen und nachfassen.' },
  { icon: 'table', h: 'Daten- und Stammdatenpflege', p: 'Erfassen und Pflegen von Daten in Ihren Listen und Systemen.' },
];

const audiences = [
  {
    icon: 'doc',
    h: 'Steuerkanzleien',
    p: 'Die wiederkehrende Arbeit, für die Sie keine Fachkraft finden: Belegvorerfassung, Mandantenunterlagen anfordern und nachhalten, Postfach und Fristen, Neumandanten-Aufnahme.',
    points: ['Arbeit in Ihren Systemen, nach Ihren Regeln', 'Verschwiegenheit nach § 62a StBerG vertraglich geregelt', 'Fester Ansprechpartner statt wechselnder Aushilfen'],
  },
  {
    icon: 'folder',
    h: 'Hausverwaltungen',
    p: 'Vom Leerstand bis zum unterschriebenen Mietvertrag: Inserate pflegen, Anfragen beantworten, Besichtigungen koordinieren, Unterlagen einsammeln.',
    points: ['Inserate auf ImmoScout24 & Co. betreuen', 'Besichtigungstermine vereinbaren und bestätigen', 'Mieterunterlagen anfordern und prüfen'],
  },
  {
    icon: 'truck',
    h: 'Kleine und mittlere Unternehmen',
    p: 'Verwaltung, die liegen bleibt, weil niemand Zeit hat: Dokumente, Datenerfassung, Postfach, Kundenkommunikation, Terminkoordination.',
    points: ['Umfang nach Absprache – auch wenige Stunden pro Woche', 'Deutsch und Englisch', 'Einarbeitung nach Ihren Vorlagen'],
  },
];
---
<Base
  path="/"
  title="Back Office für Kanzleien, Hausverwaltungen und KMU | SION Consulting"
  description="SION Consulting übernimmt wiederkehrende Verwaltungsaufgaben für Steuerkanzleien, Hausverwaltungen und mittelständische Unternehmen in Deutschland – aus unserem Büro in Tirana, mit festem Ansprechpartner.">

  <section class="page-hero">
    <div class="container">
      <div class="hero-copy">
        <p class="eyebrow">Back Office Services</p>
        <h1>Die Arbeit, für die Sie niemanden finden</h1>
        <p class="lead">
          Belegvorerfassung, Unterlagen einsammeln, Postfach, Termine. SION Consulting übernimmt die
          wiederkehrende Verwaltungsarbeit für Steuerkanzleien, Hausverwaltungen und mittelständische
          Unternehmen in Deutschland – aus unserem Büro in Tirana, mit einem festen Ansprechpartner
          und auf Deutsch.
        </p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#anfrage">Gespräch vereinbaren</a>
          <a class="btn btn-lg" href="/leistungen">Leistungen ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head">
        <h2>Für wen wir arbeiten</h2>
        <p class="muted">Drei Bereiche, in denen dieselbe Arbeit jeden Monat wiederkommt.</p>
      </div>
      <div class="grid-3">
        {audiences.map((a) => (
          <article class="card">
            <Icon name={a.icon} class="card-icon" />
            <h3>{a.h}</h3>
            <p>{a.p}</p>
            <ul class="checklist" style="margin-top: 12px">
              {a.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head"><h2>Was wir übernehmen</h2></div>
      <div class="grid-3" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr))">
        {services.map((s) => (
          <article class="card">
            <Icon name={s.icon} class="card-icon" />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 24px"><a href="/leistungen">Alle Leistungen im Detail →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2" style="align-items: start">
      <div class="stack-lg">
        <h2>Warum das funktioniert</h2>
        <p>
          Wir stellen die Mitarbeiter in Albanien an, arbeiten in Ihren Systemen und nach Ihren
          Vorlagen. Sie bekommen einen festen Ansprechpartner statt wechselnder Aushilfen – und
          müssen weder einstellen noch einarbeiten, wenn jemand ausfällt.
        </p>
        <ul class="checklist">
          <li>Kein eigener Recruiting- und Einstellungsaufwand</li>
          <li>Umfang monatlich anpassbar, auch wenige Stunden pro Woche</li>
          <li>Deutschsprachige Bearbeitung</li>
          <li>Vertretung geregelt – Urlaub und Krankheit sind unser Problem, nicht Ihres</li>
        </ul>
      </div>
      <div class="stack-lg">
        <h2>Vertraulichkeit</h2>
        <p>
          Wir behandeln Ihre Unterlagen vertraulich. Für die Verarbeitung personenbezogener Daten in
          Ihrem Auftrag schließen wir mit Ihnen einen Vertrag zur Auftragsverarbeitung nach
          Art. 28 DSGVO.
        </p>
        <p>
          Für Steuerkanzleien regeln wir zusätzlich die Verschwiegenheit der mitwirkenden Personen
          nach § 62a StBerG schriftlich, bevor die erste Akte bearbeitet wird.
        </p>
        <p class="muted">
          Welche Unterlagen Sie uns geben und welche nicht, entscheiden Sie. Den Umfang legen wir
          vor dem Start gemeinsam fest.
        </p>
      </div>
    </div>
  </section>

  <section id="anfrage" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>Back Office anfragen</h2>
        <p class="muted">
          Beschreiben Sie kurz, welche Aufgaben Sie abgeben möchten. Wir melden uns innerhalb von
          1 Werktag mit einem Vorschlag – unverbindlich.
        </p>
        <p><strong>Lieber per E-Mail?</strong><br /><a class="big-phone" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <AnfrageForm />
    </div>
  </section>
</Base>
