---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AnfrageForm from '../components/AnfrageForm.astro';
import { site } from '../config';

const services = [
  { icon: 'mail', h: 'Postfach, Telefon, Termine', p: 'E-Mails sortieren und beantworten, Anrufe entgegennehmen, Termine vereinbaren und bestätigen.' },
  { icon: 'inbox', h: 'Unterlagen anfordern', p: 'Fehlende Unterlagen bei Ihren Kunden anfragen, nachfassen und richtig ablegen.' },
  { icon: 'doc', h: 'Buchhaltung vorbereiten', p: 'Belege sortieren, vorkontieren und erfassen – auch in DATEV, nach Ihren Kontierungsregeln.' },
  { icon: 'users', h: 'Anfragen und Leads', p: 'Neue Anfragen erfassen, beantworten und nachfassen, damit nichts liegen bleibt.' },
  { icon: 'table', h: 'Daten- und Stammdatenpflege', p: 'Erfassen und Pflegen von Daten in Ihren Listen und Systemen.' },
  { icon: 'folder', h: 'Allgemeine Büroorganisation', p: 'Wiederkehrende Büroarbeit – Umfang nach Absprache, auch wenige Stunden pro Woche.' },
];

const trust = [
  { icon: 'shield', h: 'Arbeit in Ihren Systemen', p: 'Wir arbeiten in Ihrem Postfach, Ihrer Software und Ihrem DATEV – mit Zugängen, die Sie jederzeit entziehen können.' },
  { icon: 'doc', h: 'Vertrag zur Auftragsverarbeitung', p: 'Nach Art. 28 DSGVO, mit EU-Standardvertragsklauseln und schriftlicher Verschwiegenheit jedes Mitarbeiters.' },
  { icon: 'globe', h: 'Deutschsprachiges Team in Tirana', p: 'Unsere Mitarbeiter sprechen Deutsch und arbeiten zu deutschen Bürozeiten – Albanien liegt in derselben Zeitzone.' },
  { icon: 'users', h: 'Ein Ansprechpartner', p: 'Behar Nela betreut Sie persönlich und ist Ihr Ansprechpartner für Vertrag und Qualität.' },
];

const audiences = [
  {
    icon: 'doc',
    h: 'Steuerkanzleien',
    p: 'Die wiederkehrende Arbeit, für die Sie keine Fachkraft finden: Belegvorerfassung, Mandantenunterlagen anfordern und nachhalten, Postfach und Fristen, Neumandanten-Aufnahme.',
    points: ['Arbeit in Ihren Systemen, nach Ihren Regeln', 'Verschwiegenheit nach § 62a StBerG vertraglich geregelt', 'Fester Ansprechpartner statt wechselnder Aushilfen'],
  },
  {
    icon: 'folder',
    h: 'Hausverwaltungen',
    p: 'Vom Leerstand bis zum unterschriebenen Mietvertrag: Inserate pflegen, Anfragen beantworten, Besichtigungen koordinieren, Unterlagen einsammeln.',
    points: ['Inserate auf ImmoScout24 & Co. betreuen', 'Besichtigungstermine vereinbaren und bestätigen', 'Mieterunterlagen anfordern und prüfen'],
  },
  {
    icon: 'truck',
    h: 'Kleine und mittlere Unternehmen',
    p: 'Verwaltung, die liegen bleibt, weil niemand Zeit hat: Dokumente, Datenerfassung, Postfach, Kundenkommunikation, Terminkoordination.',
    points: ['Umfang nach Absprache – auch wenige Stunden pro Woche', 'Deutsch und Englisch', 'Einarbeitung nach Ihren Vorlagen'],
  },
];
---
<Base
  path="/"
  title="Büroarbeit erledigt, ab 29 € pro Stunde | Sion Office"
  description="Sion Office übernimmt Ihre Büroarbeit: Postfach, Unterlagen, Anfragen und die Vorbereitung Ihrer Buchhaltung. Deutschsprachig, remote aus Tirana, ab 29 € pro Stunde. 4 Wochen testen für 690 €.">

  <section class="page-hero">
    <div class="container">
      <div class="hero-copy">
        <p class="eyebrow">Back Office für Unternehmen und Steuerkanzleien</p>
        <h1>Ihre Büroarbeit erledigt – deutschsprachig, ab 29 € pro Stunde</h1>
        <p class="lead">
          Sie suchen eine Bürokraft und finden niemanden? Unser Team übernimmt Postfach, Unterlagen,
          Anfragen und die Vorbereitung Ihrer Buchhaltung – ohne Lohnnebenkosten und ohne Ausfall
          bei Urlaub und Krankheit. Testen Sie uns 4 Wochen für 690 €.
        </p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#anfrage">Erstgespräch vereinbaren</a>
          <a class="btn btn-lg" href="/preise">Preise ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head">
        <h2>Für wen wir arbeiten</h2>
        <p class="muted">Drei Bereiche, in denen dieselbe Arbeit jeden Monat wiederkommt.</p>
      </div>
      <div class="grid-3">
        {audiences.map((a) => (
          <article class="card">
            <Icon name={a.icon} class="card-icon" />
            <h3>{a.h}</h3>
            <p>{a.p}</p>
            <ul class="checklist" style="margin-top: 12px">
              {a.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head"><h2>Was wir übernehmen</h2></div>
      <div class="grid-3" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr))">
        {services.map((s) => (
          <article class="card">
            <Icon name={s.icon} class="card-icon" />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 24px"><a href="/leistungen">Alle Leistungen im Detail →</a></p>
    </div>
  </section>

  <section class="section band-dark">
    <div class="container grid-2" style="align-items: start">
      <div class="stack-lg">
        <p class="eyebrow">Für Steuerkanzleien</p>
        <h2>Ja, Sie dürfen auslagern</h2>
        <p>
          § 62a StBerG erlaubt die Einbindung von Dienstleistern unter klaren Bedingungen:
          schriftlicher Vertrag, Verschwiegenheit der mitwirkenden Personen und bei Auslandsbezug
          ein vergleichbarer Schutz. Genau das regeln wir, bevor die erste Akte bearbeitet wird.
        </p>
        <p class="muted">
          Das Vertragspaket – Dienstleistungsvertrag, Auftragsverarbeitung nach Art. 28 DSGVO mit
          EU-Standardvertragsklauseln und die Verschwiegenheitsverpflichtung – erhalten Sie vor dem
          Start. Prüfen Sie es bitte im Einzelfall selbst; wir leisten keine Rechtsberatung.
        </p>
      </div>
      <div class="stack-lg">
        <h3>Typische Aufgaben in der Kanzlei</h3>
        <ul class="checklist">
          <li>Belege sortieren, vorkontieren und in DATEV erfassen</li>
          <li>Fehlende Mandantenunterlagen anfordern und nachhalten</li>
          <li>Kanzleipostfach sortieren, Standardanfragen beantworten</li>
          <li>Neumandanten-Unterlagen vorbereiten und Stammdaten anlegen</li>
        </ul>
        <p class="muted">Mandantendaten bleiben in Ihren Systemen. Die Zugänge vergeben Sie – und können sie jederzeit entziehen.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Datenschutz und Vertrauen</h2>
        <p class="muted">Ihre Daten bleiben bei Ihnen.</p>
      </div>
      <div class="grid-2" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px; align-items: stretch">
        {trust.map((t) => (
          <article class="card">
            <Icon name={t.icon} class="card-icon" />
            <h3>{t.h}</h3>
            <p>{t.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container stack-lg" style="text-align: center">
      <h2>4 Wochen testen für 690 €</h2>
      <p class="muted">40 Stunden mit einer festen Person. Der Betrag wird angerechnet, wenn Sie weitermachen.</p>
      <div class="btn-row" style="justify-content: center">
        <a class="btn btn-accent btn-lg" href="/preise">Alle Preise ansehen</a>
      </div>
    </div>
  </section>

  <section id="anfrage" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>Back Office anfragen</h2>
        <p class="muted">
          Beschreiben Sie kurz, welche Aufgaben Sie abgeben möchten. Wir melden uns innerhalb von
          1 Werktag mit einem Vorschlag – unverbindlich.
        </p>
        <p><strong>Lieber per E-Mail?</strong><br /><a class="big-phone" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <AnfrageForm />
    </div>
  </section>
</Base>
