---
import Base from '../layouts/Base.astro';

const steps = [
  ['Erstgespräch, 15 Minuten', 'Sie erzählen, welche Arbeit liegen bleibt. Wir sagen Ihnen offen, ob und wie wir helfen können.'],
  ['4 Wochen testen', '40 Stunden mit einer festen Person aus unserem Team, für 690 €. Sie sehen jede Woche, was erledigt wurde.'],
  ['Feste Zusammenarbeit', 'Passt es, wählen Sie Stunden oder eine feste Kraft. Der Testpreis wird angerechnet.'],
];

const faq = [
  ['Wer arbeitet für mich?', 'Eine feste Person aus unserem Team in Tirana, die Deutsch spricht. Sie lernt Ihre Abläufe im Test kennen und bleibt Ihre Ansprechperson. Urlaub und Krankheit vertreten wir intern.'],
  ['Darf eine Steuerkanzlei Arbeiten auslagern?', 'Ja. § 62a StBerG erlaubt die Einbindung von Dienstleistern unter bestimmten Bedingungen: schriftlicher Vertrag, Verschwiegenheit der mitwirkenden Personen und bei Auslandsbezug ein vergleichbarer Schutz. Das regeln wir vor dem Start. Prüfen Sie das Vertragspaket bitte im Einzelfall selbst – wir leisten keine Rechtsberatung.'],
  ['Wo liegen meine Daten?', 'In Ihren Systemen. Wir arbeiten in Ihrem Postfach, Ihrer Software und Ihrem DATEV mit Zugängen, die Sie vergeben und jederzeit entziehen können. Grundlage ist ein Vertrag zur Auftragsverarbeitung nach Art. 28 DSGVO mit EU-Standardvertragsklauseln.'],
  ['Zu welchen Zeiten wird gearbeitet?', 'Zu deutschen Bürozeiten. Albanien liegt in derselben Zeitzone – es gibt keine Zeitverschiebung.'],
  ['Was kostet mich der Einstieg?', '690 € für den Test (40 Stunden in 4 Wochen). Die Einrichtung – Zugänge, Vertragspaket und Einarbeitung – kostet 490 € einmalig und entfällt nach dem Test.'],
  ['Bin ich an eine Laufzeit gebunden?', 'Flex ist monatlich kündbar. Nur die volle Kraft hat 3 Monate Mindestlaufzeit, danach ebenfalls monatlich.'],
  ['Ist das Arbeitnehmerüberlassung?', 'Nein. Die Mitarbeiter sind bei uns angestellt und erbringen eine Dienstleistung für Sie – Sie stellen niemanden ein.'],
  ['Wie schnell können wir starten?', 'In der Regel innerhalb von zwei Wochen nach dem Erstgespräch.'],
];
---
<Base
  path="/ablauf"
  title="Ablauf – so starten wir | Sion Office"
  description="In drei Schritten starten: Erstgespräch in 15 Minuten, 4 Wochen testen für 690 €, dann feste Zusammenarbeit. Der Testpreis wird angerechnet.">

  <section class="page-hero">
    <div class="container">
      <div class="hero-copy">
        <p class="eyebrow">Ablauf</p>
        <h1 class="h1-md">So starten wir</h1>
        <p class="lead">
          Drei Schritte. Sie legen sich erst fest, wenn Sie vier Wochen gesehen haben, wie wir
          arbeiten – und der Testpreis wird dann angerechnet.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <ol class="steps">
        {steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head"><h2>Häufige Fragen</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-sand">
    <div class="container stack-lg" style="text-align: center">
      <h2>Noch Fragen offen?</h2>
      <p class="muted">Im Erstgespräch klären wir in 20 Minuten, ob sich das für Sie rechnet.</p>
      <div class="btn-row" style="justify-content: center">
        <a class="btn btn-accent btn-lg" href="/kontakt#anfrage">Gespräch vereinbaren</a>
      </div>
    </div>
  </section>
</Base>
